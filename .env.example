# Build-time flags baked into the bundle by Vite. Copy to .env for local dev.

# Flavor: ManagedService | SelfHosted | Enterprise
VITE_ADMIN_RELEASE=ManagedService

# Brand + auth config mode:
#   dynamic (default) — start from neutral defaults, fetch the project's Brand
#                       + auth config from the public endpoint, and override.
#   static            — load brand + auth ENTIRELY from the bundled per-project
#                       config (config/projects/{id}.json); never call the
#                       endpoint. For forkers who want full control + fastest paint.
VITE_ADMIN_CONFIG_MODE=dynamic

# Hub endpoint — the ONLY endpoint you normally need to set.
# On boot the portal calls the Hub's GET /{version}/echo to discover the API
# URL, regions, release, and license.
VITE_ADMIN_HUB_BASE_URL=https://hub.norbix.ai
VITE_ADMIN_HUB_VERSION=v3

# API endpoint — optional. Normally discovered from /echo; only set this to
# override (or as a fallback when the Hub is unreachable).
# VITE_ADMIN_API_BASE_URL=https://api.norbix.ai
# VITE_ADMIN_API_VERSION=v3

# Optional: pin the project id for self-hosted / enterprise custom-domain
# builds. Leave empty for managed service (project comes from the pr_* subdomain).
VITE_ADMIN_PROJECT_ID=

# ── Local dev example ──────────────────────────────────────────────
# Point at your local gateway and the portal will fetch echo from it:
# VITE_ADMIN_HUB_BASE_URL=http://localhost:5001
# (echo then returns apiUrl=http://localhost:5002/v3, regions, etc.)
