# Norbix Admin Portal — configuration. Copy to .env and fill in.
# The server reads these when it runs. None of them reaches the browser.

# ── Required ─────────────────────────────────────────────────────────
# The project this portal serves. Copy the project id from Norbix Cloud
# (it starts with "pr_").
PROJECT_ID=

# The API key of the project's Admin Portal service user
# (Norbix Cloud → Project Settings → Admin Portal). Keep it secret.
API_KEY=

# Without these two the portal shows a setup page that names what is missing.

# ── Optional ─────────────────────────────────────────────────────────
# Project environment. Unset = PROD. Use "staging" or "test" for that one.
# ENV=staging

# Where the Norbix Hub and API are. The defaults are right for norbix.ai.
# HUB_BASE_URL=https://hub.norbix.ai
# API_BASE_URL=https://api.norbix.ai

# API versions. Default v3.
# HUB_VERSION=v3
# API_VERSION=v3

# Build-time, browser: where brand + sign-in options come from.
#   dynamic (default) — asked from Norbix, so changes in Cloud show up at once.
#   static            — never asked from Norbix: the built-in defaults are
#                       used. (The bundled config/projects/<project id>.json
#                       file is not loaded by the Next.js build yet.)
# NEXT_PUBLIC_ADMIN_CONFIG_MODE=dynamic
