# Build-time flags baked into the bundle by Vite. Copy to .env for local dev.

# Brand + auth config mode:
#   dynamic (default) — start from neutral defaults, fetch the project's brand
#                       + auth config from the public endpoint, and override.
#   static            — load brand + auth ENTIRELY from the bundled per-project
#                       config (config/projects/{id}.json); never call the
#                       endpoint. For forkers who want full control + fastest paint.
VITE_ADMIN_CONFIG_MODE=dynamic

# Hub endpoint — the ONLY endpoint you set. On boot the portal calls the Hub's
# GET /{version}/echo to discover the API URL, regions, release, and license.
# The API base is ALWAYS taken from echo (there is no VITE_ADMIN_API_BASE_URL):
# the portal blocks the UI until echo resolves.
#
# Local dev: point this at your local gateway hub, e.g.
#   VITE_ADMIN_HUB_BASE_URL=http://localhost:5001
VITE_ADMIN_HUB_BASE_URL=https://hub.norbix.ai
VITE_ADMIN_HUB_VERSION=v3

# Optional: pin the project id. Resolution order is:
#   1. VITE_ADMIN_PROJECT_ID (this) — self-hosted / custom-domain builds.
#   2. the pr_{base62} subdomain — managed multi-tenant (pr_x.admin.norbix.ai).
#   3. a custom domain (e.g. admin.acme.com) — resolved by asking the managed
#      service which project the domain maps to (no id in the hostname).
# Set this for a single-project self-hosted/custom-domain deployment to skip
# all lookups. Leave empty for managed service.
VITE_ADMIN_PROJECT_ID=
