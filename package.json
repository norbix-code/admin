{
  "name": "@norbix/admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite --host localhost --port 3100",
    "dev:link": "NORBIX_LINK=1 vite --host localhost --port 3100",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@norbix.ai/ts": "file:../sdks/norbix-js",
    "@norbix/react-redux": "file:../sdks/norbix-react-redux",
    "@reduxjs/toolkit": "^2.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^16.0.0",
    "postcss": "^8.5.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
