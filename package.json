{
  "name": "@norbix/admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "format": "prettier --write \"{src,app}/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{src,app}/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:e2e:update": "playwright test -c tests/e2e/playwright.config.ts --update-snapshots",
    "test:e2e:stack": "playwright test -c tests/e2e/playwright.stack.config.ts",
    "_vite:dev": "vite --host localhost --port 3100",
    "_vite:dev:link": "NORBIX_LINK=1 vite --host localhost --port 3100",
    "_vite:build": "tsc -b && vite build"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@norbix.ai/react-redux": "^1.4.0",
    "@norbix.ai/ts": "^4.4.0",
    "@reduxjs/toolkit": "^2.12.0",
    "final-form": "^5.0.1",
    "next": "^15.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-final-form": "^7.0.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.0",
    "redux-persist": "^6.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.28"
    }
  }
}
